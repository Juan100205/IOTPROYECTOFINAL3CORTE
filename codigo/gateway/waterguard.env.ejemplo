# =====================================================================
#  WaterGuard v9 - Configuración del Gateway (Raspberry Pi)
#  En la SD queda en la partición "bootfs": /boot/firmware/waterguard.env
#  Se puede editar desde cualquier PC (Windows/Mac/Linux) antes de
#  prender la Raspberry. Al arrancar, la Pi aplica estos valores.
# =====================================================================

# --- WiFi de la zona (la "WLAN de las autoridades") ---
# Debe ser la MISMA red a la que se conecta el ESP32.
WG_WIFI_SSID=WLAN_ALCALDIA
WG_WIFI_CLAVE=clave-de-la-red
WG_WIFI_PAIS=CO

# --- Broker MQTT local (Mosquitto en la Raspberry) ---
# Usuario/clave del ESP32 (deben coincidir con MQTT_USUARIO/MQTT_CLAVE del firmware)
WG_MQTT_NODO_USUARIO=nodo1
WG_MQTT_NODO_CLAVE=WaterGuard-Nodo1
# Usuario/clave interno del programa del gateway
WG_MQTT_GW_USUARIO=gateway
WG_MQTT_GW_CLAVE=Gateway-Local-2026
WG_MQTT_HOST=localhost
WG_MQTT_PUERTO=1883

# --- Base de datos local ---
WG_DB=/var/lib/waterguard/waterguard.db

# --- Plataforma IoT en la nube: thingsboard | ubidots | ninguna ---
WG_PLATAFORMA=thingsboard
# LeMarTek Cloud for IoT: MQTT sobre WebSockets seguro por el túnel de Cloudflare
WG_NUBE_HOST=mqtt.lemartek.cloud
WG_NUBE_PUERTO=443
WG_NUBE_TRANSPORTE=websockets
WG_NUBE_TLS=1
WG_NUBE_USUARIO=gateway-nodo1
WG_NUBE_CLAVE=cambiar-esta-clave
# Opcional: si mqtt.lemartek.cloud está protegido con Cloudflare Access (service token)
WG_CF_ACCESS_CLIENT_ID=
WG_CF_ACCESS_CLIENT_SECRET=
# Para Ubidots: WG_NUBE_HOST=industrial.api.ubidots.com, WG_NUBE_PUERTO=1883,
#               WG_NUBE_TRANSPORTE=tcp, WG_NUBE_TLS=0, WG_NUBE_TOKEN=BBUS-...
WG_NUBE_TOKEN=
WG_UBIDOTS_DISPOSITIVO=waterguard-nodo1

# --- Módulo de IA (Claude, de Anthropic) ---
WG_IA_ACTIVA=1
ANTHROPIC_API_KEY=
WG_IA_MODELO=claude-opus-5-5
# Cada cuántos minutos se pide un análisis (además, uno inmediato al entrar en ALERTA/CRITICO)
WG_IA_PERIODO_MIN=15

# --- Datos del tanque ---
WG_TANQUE_LITROS=1000
WG_NIVEL_CRITICO=15
WG_NODO=nodo1
